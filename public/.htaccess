RewriteEngine On
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTPS} !on
RewriteRule ^(.*)$ https://dtaycan.com.tr/$1 [R=301,L]
RewriteCond %{HTTP_HOST} ^www\.dtaycan\.com\.tr$ [NC]
RewriteRule ^(.*)$ https://dtaycan.com.tr/$1 [R=301,L]
DirectoryIndex index.html
DirectorySlash Off
RewriteRule ^(tedaviler|rehber|[a-z]{2}/(treatments|guides))/$ /$1 [R=301,L]
RewriteRule ^(tedaviler|rehber|[a-z]{2}/(treatments|guides))$ $1/index.html [L]
RewriteRule ^(en|de|fr|ru|bg|ar|fa)$ /$1/ [R=301,L]
RewriteRule ^de/guides/clear-aligners-who-is-suitable/?$ /de/guides/fuer-wen-eignen-sich-aligner [R=301,L]
RewriteRule ^de/guides/dental-implant-process-step-by-step/?$ /de/guides/implantat-ablauf-schritt-fuer-schritt [R=301,L]
RewriteRule ^de/guides/childs-first-dental-visit/?$ /de/guides/erster-zahnarztbesuch-kind [R=301,L]
RewriteRule ^de/guides/how-long-does-teeth-whitening-last/?$ /de/guides/wie-lange-haelt-zahnaufhellung [R=301,L]
RewriteRule ^de/guides/why-do-gums-bleed/?$ /de/guides/warum-blutet-zahnfleisch [R=301,L]
RewriteRule ^de/guides/dental-health-during-pregnancy/?$ /de/guides/zahngesundheit-in-der-schwangerschaft [R=301,L]
RewriteRule ^de/guides/bad-breath-causes/?$ /de/guides/mundgeruch-ursachen [R=301,L]
RewriteRule ^de/guides/teeth-grinding-bruxism/?$ /de/guides/zaehneknirschen-bruxismus [R=301,L]
RewriteRule ^de/guides/when-to-remove-wisdom-teeth/?$ /de/guides/weisheitszaehne-wann-entfernen [R=301,L]
RewriteRule ^de/guides/orthodontics-for-children-when/?$ /de/guides/kieferorthopaedie-bei-kindern-wann [R=301,L]
RewriteRule ^de/guides/tooth-sensitivity-causes/?$ /de/guides/empfindliche-zaehne-ursachen [R=301,L]
RewriteRule ^de/guides/teaching-children-to-brush/?$ /de/guides/kindern-zaehneputzen-beibringen [R=301,L]
RewriteRule ^de/guides/implant-or-bridge/?$ /de/guides/implantat-oder-bruecke [R=301,L]
RewriteRule ^de/guides/pain-after-root-canal/?$ /de/guides/schmerzen-nach-wurzelkanalbehandlung [R=301,L]
RewriteRule ^de/guides/is-scaling-harmful/?$ /de/guides/schadet-zahnsteinentfernung [R=301,L]
RewriteRule ^de/guides/zirconia-or-porcelain-crowns/?$ /de/guides/zirkon-oder-metallkeramik-krone [R=301,L]
RewriteRule ^de/guides/dental-abscess-symptoms-treatment/?$ /de/guides/zahnabszess-symptome-behandlung [R=301,L]
RewriteRule ^de/guides/who-needs-a-night-guard/?$ /de/guides/wer-braucht-aufbissschiene [R=301,L]
RewriteRule ^de/guides/broken-or-knocked-out-tooth/?$ /de/guides/zahn-abgebrochen-ausgeschlagen [R=301,L]
RewriteRule ^de/guides/teething-in-babies/?$ /de/guides/zahnen-bei-babys [R=301,L]
RewriteRule ^de/guides/diabetes-and-gum-health/?$ /de/guides/diabetes-und-zahnfleischgesundheit [R=301,L]
RewriteRule ^de/guides/smoking-and-oral-health/?$ /de/guides/rauchen-und-zahngesundheit [R=301,L]
RewriteRule ^de/guides/are-dental-x-rays-safe/?$ /de/guides/sind-zahnroentgen-sicher [R=301,L]
RewriteRule ^de/guides/electric-or-manual-toothbrush/?$ /de/guides/elektrische-oder-handzahnbuerste [R=301,L]
RewriteRule ^de/guides/how-to-floss/?$ /de/guides/zahnseide-richtig-anwenden [R=301,L]
RewriteRule ^de/guides/why-teeth-turn-yellow/?$ /de/guides/warum-werden-zaehne-gelb [R=301,L]
RewriteRule ^de/guides/gum-recession-causes/?$ /de/guides/zahnfleischrueckgang-ursachen [R=301,L]
RewriteRule ^de/guides/impacted-teeth/?$ /de/guides/verlagerter-zahn [R=301,L]
RewriteRule ^de/guides/canker-sores-mouth-ulcers/?$ /de/guides/aphthen-mundgeschwuere [R=301,L]
RewriteRule ^de/guides/jaw-joint-pain-tmj/?$ /de/guides/kiefergelenkschmerzen-cmd [R=301,L]
RewriteRule ^de/guides/denture-care/?$ /de/guides/pflege-herausnehmbarer-prothesen [R=301,L]
RewriteRule ^de/guides/overcoming-dental-anxiety/?$ /de/guides/zahnarztangst-ueberwinden [R=301,L]
RewriteRule ^de/guides/pain-after-a-filling/?$ /de/guides/schmerzen-nach-fuellung [R=301,L]
RewriteRule ^de/guides/aftercare-following-tooth-extraction/?$ /de/guides/pflege-nach-zahnentfernung [R=301,L]
RewriteRule ^de/guides/porcelain-veneers-laminates/?$ /de/guides/veneers-was-sind-sie [R=301,L]
RewriteRule ^de/guides/mouthwash-how-and-when/?$ /de/guides/mundspuelung-wann-und-wie [R=301,L]
RewriteRule ^de/guides/preventing-tooth-decay-in-children/?$ /de/guides/karies-vorbeugen-bei-kindern [R=301,L]
RewriteRule ^de/guides/how-long-do-crowns-last/?$ /de/guides/wie-lange-haelt-zahnkrone [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]
ErrorDocument 404 /404.html
<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=31536000"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://i.ytimg.com; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; frame-src https://www.google.com https://www.youtube-nocookie.com"
<FilesMatch ".html$">
Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
<FilesMatch ".(jpe?g|png|webp|svg)$">
Header set Access-Control-Allow-Origin "*"
</FilesMatch>
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/svg+xml "access plus 30 days"
ExpiresByType image/webp "access plus 30 days"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType text/css "access plus 7 days"
ExpiresByType application/javascript "access plus 7 days"
</IfModule>
